# Port the API listens on.
PORT=5000

# Comma-separated list of origins allowed to call this API.
# The frontend dev server default (http://localhost:5173) is always allowed in development.
FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
# LEAVE THIS BLANK to run the API straight from src/data/seed.data.ts with no database.
# That is the fastest way to develop the site locally.
MONGO_URI=

NODE_ENV=development
