# Port the API listens on.
PORT=5000

# Comma-separated list of origins allowed to call this API.
# Any localhost port is always allowed in development.
#
# A `*` may be used for one hostname label, which is how you allow Vercel
# preview deployments (each commit gets its own URL). Example for production:
#   FRONTEND_URL=https://maralitdental.ph,https://mdcas-fe.vercel.app,https://*.vercel.app
# Keep wildcards narrow — `https://*.vercel.app` trusts every project on that
# domain, so use it for previews only and list your real domain explicitly.
FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
# LEAVE THIS BLANK to run the API straight from src/data/seed.data.ts with no database.
# That is the fastest way to develop the site locally.
MONGO_URI=

NODE_ENV=development
